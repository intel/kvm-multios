<domain xmlns:qemu="http://libvirt.org/schemas/domain/qemu/1.0" type="kvm">
  <name>windows11</name>
  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://microsoft.com/win/11"/>
    </libosinfo:libosinfo>
  </metadata>
  <memory>4194304</memory>
  <currentMemory>4194304</currentMemory>
  <memoryBacking>
    <hugepages>
      <page size="2048" unit="KiB"/>
    </hugepages>
    <nosharepages/>
    <source type="memfd"/>
    <access mode="shared"/>
    <allocation mode="immediate"/>
  </memoryBacking>
  <vcpu>2</vcpu>
  <os>
    <type arch="x86_64" machine="q35">hvm</type>
    <loader readonly="yes" type="pflash">/usr/share/OVMF/OVMF_CODE_4M.fd</loader>
    <nvram template="/usr/share/OVMF/OVMF_VARS_4M.fd"/>
    <boot dev="hd"/>
  </os>
  <features>
    <acpi/>
    <apic/>
    <hyperv>
      <relaxed state="on"/>
      <vapic state="on"/>
      <spinlocks state="on" retries="4096"/>
      <vpindex state="on"/>
      <synic state="on"/>
      <runtime state="on"/>
      <stimer state="on"/>
      <ipi state="on"/>
      <tlbflush state="on"/>
      <reset state="on"/>
    </hyperv>
    <kvm>
      <hidden state="on"/>
    </kvm>
    <vmport state="off"/>
  </features>
  <cpu mode="host-passthrough">
    <maxphysaddr mode="passthrough" limit="39"/>
  </cpu>
  <clock offset="localtime">
    <timer name="rtc" tickpolicy="catchup"/>
    <timer name="pit" tickpolicy="delay"/>
    <timer name="hpet" present="no"/>
    <timer name="hypervclock" present="yes"/>
  </clock>
  <pm>
    <suspend-to-mem enabled="yes"/>
    <suspend-to-disk enabled="yes"/>
  </pm>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2" cache="none" discard="unmap"/>
      <source file="/var/lib/libvirt/images/windows11.qcow2"/>
      <target dev="vda" bus="virtio"/>
    </disk>
    <controller type="usb" model="qemu-xhci" ports="15"/>
    <controller type="pci" model="pcie-root"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <interface type="network">
      <source network="default"/>
      <mac address="52:54:00:ab:cd:55"/>
      <model type="virtio"/>
    </interface>
    <console type="pty"/>
    <channel type="unix">
      <source mode="bind"/>
      <target type="virtio" name="org.qemu.guest_agent.0"/>
    </channel>
    <channel type="spicevmc">
      <target type="virtio" name="com.redhat.spice.0"/>
    </channel>
    <redirdev bus="usb" type="spicevmc"/>
    <redirdev bus="usb" type="spicevmc"/>
    <!-- Deliberately no gl element on the spice device. Enabling it makes QEMU hand the
         scanout to the client as a dmabuf fd (SPICE_MSG_DISPLAY_GL_SCANOUT_UNIX), which
         needs SCM_RIGHTS over a unix socket. A remote client over TCP can never ack
         gl-draw-done, so QEMU keeps virtio-gpu blocked ("no gl-draw-done within one
         second") and the guest display hangs with nothing to encode. The egl-headless
         device below gives QEMU a real EGL context instead; the framebuffer is read back
         and encoded normally, which is what remote spice-gst clients require. -->
    <graphics type="spice" port="5955" listen="127.0.0.1">
      <streaming mode="all"/>
      <mouse mode="client"/>
      <clipboard copypaste="yes"/>
    </graphics>
    <graphics type="egl-headless">
      <gl rendernode="/dev/dri/renderD128"/>
    </graphics>
    <input type="tablet" bus="usb"/>
    <sound model="ich9">
      <codec type="micro"/>
      <audio id="1"/>
      <alias name="sound0"/>
    </sound>
    <audio id="1" type="spice">
      <input mixingEngine="yes" fixedSettings="no"/>
      <output mixingEngine="yes" fixedSettings="no"/>
    </audio>
    <hostdev mode="subsystem" type="pci" managed="yes">
      <source>
        <address domain="0" bus="0" slot="2" function="5"/>
      </source>
      <address type="pci" domain="0" bus="0" slot="2" function="0"/>
    </hostdev>
    <video>
      <!-- blob='on' requires libvirt 9.2 and beyond, so add custom qemu cmdline below for now-->
      <model type="virtio" heads="1" blob="on"/>
      <driver name="qemu"/>
    </video>
    <tpm model="tpm-crb">
      <backend type="emulator" version="2.0"/>
    </tpm>
  </devices>
  <qemu:commandline>
    <!-- enable blob for virtio-vga-->
    <qemu:arg value="-spice"/>
    <qemu:arg value="preferred-codec=gstreamer:h264"/>
    <qemu:env name="SPICE_CONVERTER_PREFERRED_FORMAT" value="NV12"/>
    <qemu:env name="GST_REGISTRY_FORK" value="no"/>
    <qemu:env name="DISPLAY" value=":0"/>
  </qemu:commandline>
  <qemu:override>
    <qemu:device alias="video0">
      <qemu:frontend>
        <qemu:property name="blob" type="bool" value="true"/>
      </qemu:frontend>
    </qemu:device>
  </qemu:override>
</domain>
